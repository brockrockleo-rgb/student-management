{
  "name": "student-management-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "check:metadata": "npm run build && node scripts/check-metadata.cjs",
    "orm:debug": "mikro-orm debug",
    "mongo:indexes": "mikro-orm schema:update --run"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.1.11",
    "@mikro-orm/decorators": "^7.1.11",
    "@mikro-orm/mongodb": "^7.1.11",
    "@mikro-orm/nestjs": "^7.0.2",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.1.11",
    "@nestjs/cli": "^11.0.10",
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  }
}
